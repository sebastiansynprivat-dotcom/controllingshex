+import {
+  assertEquals,
+  assertNotStrictEquals,
+  assertStrictEquals,
+} from "jsr:@std/assert@1";
+import {
+  type AccountRow,
+  buildProfiles,
+  buildResolutions,
+  type ModelRow,
+  normalizeLogin,
+  platformKey,
+  PROFILE_KEYS,
+  type ProfileRow,
+  profileStatus,
+  projectProfile,
+  validateRequest,
+} from "./core.ts";
+
+const A = "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaa1";
+const B = "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaa2";
+const C = "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaa3";
+const D = "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaa4";
+const E = "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaa5";
+
+function model(id: string): ModelRow {
+  return { id, name: "Testmodell Fiktiva", username: null, model_active: true };
+}
+
+function account(
+  model_id: string | null,
+  platform: string,
+  account_email: string | null,
+): AccountRow {
+  return { id: E, model_id, platform, account_email };
+}
+
+Deno.test("normalization uses JavaScript trim/lowercase and literal platform keys", () => {
+  assertEquals(normalizeLogin("  Lena@Example.COM "), "lena@example.com");
+  assertEquals(
+    normalizeLogin("\u00a0\tLENA@EXAMPLE.COM\n"),
+    "lena@example.com",
+  );
+  assertEquals(normalizeLogin("  Under_%@Example.COM "), "under_%@example.com");
+  for (const value of ["", " \t\n", undefined, null, 42, false, {}, []]) {
+    assertEquals(normalizeLogin(value), null);
+  }
+  assertEquals(platformKey("4Based"), "4based");
+  assertEquals(platformKey(" 4Based "), "4based");
+  assertEquals(platformKey("4-BA_SED!"), "4based");
+  assertEquals(platformKey("Maloum"), "maloum");
+  assertEquals(platformKey("Brezzels"), "brezzels");
+  assertEquals(platformKey(" --_ "), "");
+});
+
+Deno.test("PROFILE_KEYS matches all 34 contract keys in exact order", () => {
+  const expected = (
+    "name age city occupation hobbies languages personality content_preferences no_gos " +
+    "place_of_birth favorite_color favorite_food favorite_movie favorite_music dream education " +
+    "work special_marks natural_hair shoe_size bra_size height weight " +
+    "content_anal_fingering content_anal_penetration content_anal_plug content_audios_for_chat " +
+    "content_dick_ratings content_joi content_moaning_name content_orgasm " +
+    "content_roleplay_costumes content_squirting content_video_speaking"
+  ).split(" ");
+  assertEquals(PROFILE_KEYS.length, 34);
+  assertEquals(new Set(PROFILE_KEYS).size, 34);
+  assertEquals([...PROFILE_KEYS], expected);
+  const reversed = Object.fromEntries(
+    [...expected].reverse().map((key) => [key, null]),
+  );
+  assertEquals(Object.keys(projectProfile(reversed)), expected);
+});
+
+Deno.test("projectProfile preserves values and nulls, drops private and inherited fields", () => {
+  const hobbies = ["synthetic-hobby", { nested: true }];
+  const snapshot = Object.freeze({
+    content_video_speaking: false,
+    hobbies,
+    age: null,
+    name: "Testmodell Fiktiva",
+    id: A,
+    model_id: B,
+    additional_info: "synthetic-private-value",
+    account_name: "synthetic-account-name",
+    created_at: "2026-09-20T10:00:00Z",
+    updated_at: "2026-09-20T11:00:00Z",
+    confirmed_at: "2026-09-20T12:00:00Z",
+    email: "private@example.com",
+  });
+  const projected = projectProfile(snapshot);
+  assertEquals(projected, {
+    name: "Testmodell Fiktiva",
+    age: null,
+    hobbies,
+    content_video_speaking: false,
+  });
+  assertEquals(Object.keys(projected), [
+    "name",
+    "age",
+    "hobbies",
+    "content_video_speaking",
+  ]);
+  assertNotStrictEquals(projected, snapshot);
+  assertStrictEquals(projected.hobbies, hobbies);
+  const inherited = Object.assign(
+    Object.create({ name: "Inherited fixture" }),
+    {
+      age: null,
+    },
+  );
+  assertEquals(projectProfile(inherited), { age: null });
+  assertEquals(projectProfile({ account_name: "Private fixture" }), {});
+});
+
+Deno.test("profileStatus requires confirmation and a nonempty plain snapshot object", () => {
+  assertEquals(profileStatus(undefined), "none");
+  for (const snapshot of [null, {}, [], { name: "Testmodell Fiktiva" }]) {
+    assertEquals(
+      profileStatus({ confirmed_at: null, approved_snapshot: snapshot }),
+      "not_approved",
+    );
+  }
+  for (
+    const snapshot of [
+      undefined,
+      null,
+      {},
+      [],
+      ["nonempty-array"],
+      "",
+      "nonempty-string",
+      0,
+      1,
+      false,
+      true,
+      Object.assign(new Date(0), { name: "Non-plain fixture" }),
+      Object.create({ name: "Inherited fixture" }),
+    ]
+  ) {
+    assertEquals(
+      profileStatus({
+        confirmed_at: "2026-09-20T10:15:00Z",
+        approved_snapshot: snapshot,
+      }),
+      "unusable",
+    );
+  }
+  for (
+    const snapshot of [
+      { name: null },
+      { account_name: "Only a non-exported key" },
+      Object.assign(Object.create(null), { name: "Null-prototype fixture" }),
+    ]
+  ) {
+    assertEquals(
+      profileStatus({
+        confirmed_at: "2026-09-20T10:15:00Z",
+        approved_snapshot: snapshot,
+      }),
+      "approved",
+    );
+  }
+});
+
+Deno.test("validation preserves input order, lowercases UUIDs, ignores extras and defaults profiles off", () => {
+  assertEquals(validateRequest({ action: "list_models", ignored: "fixture" }), {
+    ok: true,
+    value: { action: "list_models" },
+  });
+  assertEquals(
+    validateRequest({
+      action: "resolve",
+      identities: [{
+        platform: " 4Based ",
+        email: " LENA@EXAMPLE.COM ",
+        ignored: 1,
+      }],
+      model_ids: [B.toUpperCase(), A, B],
+      ignored: "fixture",
+    }),
+    {
+      ok: true,
+      value: {
+        action: "resolve",
+        identities: [{ platform: " 4Based ", email: " LENA@EXAMPLE.COM " }],
+        model_ids: [B, A, B],
+        include_profiles: false,
+      },
