+import { assert, assertEquals, assertRejects } from "jsr:@std/assert@1";
+import { createSupabaseStore, type ShexStore } from "./store.ts";
+
+function id(n: number): string {
+  return `10000000-0000-4000-8000-${n.toString(16).padStart(12, "0")}`;
+}
+
+function result(data: unknown[], count: number | null, offset = 0): Response {
+  const headers = new Headers({ "content-type": "application/json" });
+  if (count !== null) {
+    headers.set(
+      "content-range",
+      `${offset}-${offset + data.length - 1}/${count}`,
+    );
+  }
+  return new Response(JSON.stringify(data), { headers });
+}
+
+async function withStore(
+  reply: (url: URL) => Response,
+  run: (store: ShexStore) => Promise<void>,
+) {
+  const originalFetch = globalThis.fetch;
+  globalThis.fetch = (input, init) => {
+    const req = new Request(input, init);
+    assertEquals(req.method, "GET");
+    const url = new URL(req.url);
+    assertEquals(url.origin, "https://shex-fixture.example.com");
+    assert(
+      ["/rest/v1/accounts", "/rest/v1/models", "/rest/v1/model_profiles"]
+        .includes(url.pathname),
+    );
+    assert(req.headers.get("prefer")?.includes("count=exact"));
+    return Promise.resolve(reply(url));
+  };
+  try {
+    await run(
+      createSupabaseStore(
+        "https://shex-fixture.example.com",
+        "synthetic-service-key",
+      ),
+    );
+  } finally {
+    globalThis.fetch = originalFetch;
+  }
+}
+
+const listings = [
+  {
+    method: "listAccounts",
+    table: "accounts",
+    columns: "id,model_id,platform,account_email",
+    order: "id.asc",
+  },
+  {
+    method: "listModels",
+    table: "models",
+    columns: "id,name,username,model_active",
+    order: "id.asc",
+  },
+  {
+    method: "listProfiles",
+    table: "model_profiles",
+    columns: "model_id,confirmed_at,approved_snapshot",
+    order: "model_id.asc",
+  },
+] as const;
+
+Deno.test("store lists all three tables using exact counts and ordered pages of 1000", async () => {
+  for (const listing of listings) {
+    const offsets: number[] = [];
+    const rows = Array.from({ length: 1005 }, (_, i) => ({
+      id: id(i),
+      model_id: id(i),
+      platform: "4Based",
+      account_email: "fixture@example.com",
+      name: "Synthetic fixture model",
+      username: null,
+      model_active: true,
+      confirmed_at: null,
+      approved_snapshot: null,
+    }));
+    await withStore((url) => {
+      assertEquals(url.pathname, `/rest/v1/${listing.table}`);
+      assertEquals(url.searchParams.get("select"), listing.columns);
+      assertEquals(url.searchParams.get("order"), listing.order);
+      assertEquals(url.searchParams.get("limit"), "1000");
+      const offset = Number(url.searchParams.get("offset"));
+      offsets.push(offset);
+      return result(rows.slice(offset, offset + 1000), rows.length, offset);
+    }, async (store) => {
+      assertEquals(await store[listing.method](), rows);
+    });
+    assertEquals(offsets, [0, 1000]);
+  }
+});
+
+Deno.test("store distinguishes an empty table from missing counts or truncated pages", async () => {
+  for (const listing of listings) {
+    await withStore(() => result([], 0), async (store) => {
+      assertEquals(await store[listing.method](), []);
+    });
+    for (
+      const response of [
+        result([], null),
+        result([{ id: id(1) }], 2),
+        result([{ id: id(1) }], 0),
+      ]
+    ) {
+      await withStore(() => response, async (store) => {
+        await assertRejects(
+          () => store[listing.method](),
+          Error,
+          "incomplete_result",
+        );
+      });
+    }
+  }
+});
+
+Deno.test("store rejects counts that change between pages", async () => {
+  let calls = 0;
+  await withStore(() => {
+    calls++;
+    return calls === 1
+      ? result(Array.from({ length: 1000 }, (_, i) => ({ id: id(i) })), 1001)
+      : result([{ id: id(1000) }, { id: id(1001) }], 1002, 1000);
+  }, async (store) => {
+    await assertRejects(() => store.listModels(), Error, "incomplete_result");
+  });
+  assertEquals(calls, 2);
+});
+
+Deno.test("store stops at a full final page when the exact count is satisfied", async () => {
+  let calls = 0;
+  await withStore(() => {
+    calls++;
+    return result(
+      Array.from({ length: 1000 }, (_, i) => ({ id: id(i) })),
+      1000,
+    );
+  }, async (store) => {
+    assertEquals((await store.listModels()).length, 1000);
+  });
+  assertEquals(calls, 1);
+});
+
+Deno.test("store chunks both ID lookups into at most 200 literal IDs with exact selects", async () => {
+  const ids = Array.from({ length: 405 }, (_, i) => id(i));
+  for (
+    const lookup of [
+      {
+        method: "getModelsByIds",
+        table: "models",
+        column: "id",
+        columns: "id,name,username,model_active",
+      },
+      {
+        method: "getProfilesByModelIds",
+        table: "model_profiles",
+        column: "model_id",
+        columns: "model_id,confirmed_at,updated_at,approved_snapshot",
+      },
+    ] as const
+  ) {
+    const chunks: string[][] = [];
+    await withStore((url) => {
+      assertEquals(url.pathname, `/rest/v1/${lookup.table}`);
+      assertEquals(url.searchParams.get("select"), lookup.columns);
+      const filter = url.searchParams.get(lookup.column);
+      assert(filter !== null);
+      assert(filter?.startsWith("in.(") && filter.endsWith(")"));
+      const chunk = filter.slice(4, -1).split(",");
+      assert(chunk.length <= 200);
+      chunks.push(chunk);
+      // An absent model is legitimate: counts cover returned rows, not input IDs.
+      const rows = chunk.filter((value) => value !== ids[0]).map((value) => ({
+        [lookup.column]: value,
+      }));
+      return result(rows, rows.length);
+    }, async (store) => {
+      const rows = await store[lookup.method](
+        [...ids].reverse().concat(ids[10].toUpperCase()),
+      );
+      assertEquals(rows.length, 404);
+    });
+    assertEquals(chunks.map((chunk) => chunk.length), [200, 200, 5]);
+    assertEquals(chunks.flat(), ids);
+  }
+});
+
+Deno.test("store skips all queries for empty ID lists, including client initialization", async () => {
+  const store = createSupabaseStore("", "");
+  assertEquals(await store.getModelsByIds([]), []);
+  assertEquals(await store.getProfilesByModelIds([]), []);
+});
+
+Deno.test("store rejects incomplete ID results and never exposes database error details", async () => {
+  await withStore(() => result([{ id: id(1) }], 2), async (store) => {
+    await assertRejects(
+      () => store.getModelsByIds([id(1), id(2)]),
+      Error,
+      "incomplete_result",
+    );
+  });
+  await withStore(() => result([], null), async (store) => {
+    await assertRejects(
+      () => store.getProfilesByModelIds([id(1)]),
+      Error,
+      "incomplete_result",
+    );
+  });
+  await withStore(
+    () =>
+      new Response(
+        JSON.stringify({
+          message: "synthetic-private-error fixture@example.com",
+        }),
+        {
+          status: 400,
+          headers: { "content-type": "application/json" },
+        },
+      ),
+    async (store) => {
+      const error = await assertRejects(
+        () => store.listAccounts(),
+        Error,
+        "read_failed",
+      );
+      assertEquals(error.message, "read_failed");
+    },
+  );
+});
diff --git a/supabase/functions/controlling-model-profiles/store.ts b/supabase/functions/controlling-model-profiles/store.ts
