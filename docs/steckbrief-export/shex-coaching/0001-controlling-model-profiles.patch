+      include_profiles: true,
+    }).ok,
+    true,
+  );
+  assertEquals(
+    validateRequest({
+      action: "resolve",
+      identities: [{ platform: " ", email: " " }],
+      model_ids: [],
+    }).ok,
+    true,
+  );
+});
+
+Deno.test("validation rejects malformed shapes and UUIDs before reporting list limits", () => {
+  const base = { action: "resolve", identities: [], model_ids: [] };
+  const invalidBodies: unknown[] = [
+    null,
+    [],
+    "resolve",
+    {},
+    { action: 1 },
+    { action: "unknown", identities: [], model_ids: [] },
+    { action: "resolve" },
+    { ...base, identities: {} },
+    { ...base, model_ids: "not-an-array" },
+    ...[null, "true", 1].map((include_profiles) => ({
+      ...base,
+      include_profiles,
+    })),
+    ...[
+      null,
+      {},
+      [],
+      { platform: 1, email: "a@example.com" },
+      { platform: "", email: "a@example.com" },
+      { platform: "p".repeat(33), email: "a@example.com" },
+      { platform: "4Based", email: "" },
+      { platform: "4Based", email: "e".repeat(321) },
+      { platform: "4Based", email: null },
+    ].map((identity) => ({
+      ...base,
+      identities: [identity],
+    })),
+    ...[
+      null,
+      1,
+      "",
+      "not-a-uuid",
+      A.replace(/-/g, ""),
+      ` ${A}`,
+      `${A}\n`,
+      "gaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaa1",
+    ].map((id) => ({ ...base, model_ids: [id] })),
+    { ...base, model_ids: [...Array(1000).fill(A), "bad-uuid"] },
+  ];
+  for (const body of invalidBodies) {
+    assertEquals(validateRequest(body), {
+      ok: false,
+      error: "invalid_request",
+    });
+  }
+});
+
+Deno.test("validation limits each list independently before deduplication", () => {
+  const identity = { platform: "4Based", email: "fixture@example.com" };
+  const base = { action: "resolve", identities: [], model_ids: [] };
+  assertEquals(
+    validateRequest({
+      ...base,
+      identities: Array(1000).fill(identity),
+      model_ids: Array(1000).fill(A),
+    }).ok,
+    true,
+  );
+  for (
+    const body of [
+      { ...base, identities: Array(1001).fill(identity) },
+      { ...base, model_ids: Array(1001).fill(A) },
+      { ...base, action: "unknown", model_ids: Array(1001).fill(A) },
+    ]
+  ) {
+    assertEquals(validateRequest(body), { ok: false, error: "too_many_items" });
+  }
