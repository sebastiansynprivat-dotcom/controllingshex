index 00000000..4358ea28
--- /dev/null
+++ b/supabase/functions/controlling-model-profiles/store.ts
@@ -0,0 +1,119 @@
+import { createClient } from "https://esm.sh/@supabase/supabase-js@2";
+import {
+  type AccountRow,
+  type ModelRow,
+  type ProfileRow,
+  type ProfileSummaryRow,
+  sortedModelIds,
+} from "./core.ts";
+
+export interface ShexStore {
+  listAccounts(): Promise<AccountRow[]>;
+  listModels(): Promise<ModelRow[]>;
+  listProfiles(): Promise<ProfileSummaryRow[]>;
+  getModelsByIds(ids: readonly string[]): Promise<ModelRow[]>;
+  getProfilesByModelIds(ids: readonly string[]): Promise<ProfileRow[]>;
+}
+
+const PAGE_SIZE = 1000;
+const ID_CHUNK_SIZE = 200;
+
+export function createSupabaseStore(
+  url: string,
+  serviceKey: string,
+): ShexStore {
+  // Initialize only after the handler's method, auth and body checks succeed.
+  let client: ReturnType<typeof createClient> | undefined;
+  function database() {
+    return client ??= createClient(url, serviceKey, {
+      auth: {
+        persistSession: false,
+        autoRefreshToken: false,
+        detectSessionInUrl: false,
+      },
+    });
+  }
+
+  async function listAll<Row>(
+    table: string,
+    columns: string,
+    orderColumn: string,
+  ): Promise<Row[]> {
+    const rows: Row[] = [];
+    let expectedCount: number | undefined;
+    for (let offset = 0;; offset += PAGE_SIZE) {
+      const { data, error, count } = await database()
+        .from(table)
+        .select(columns, { count: "exact" })
+        .order(orderColumn, { ascending: true })
+        .range(offset, offset + PAGE_SIZE - 1)
+        .returns<Row[]>();
+
+      if (error || data === null) throw new Error("read_failed");
+      if (
+        count === null || !Number.isSafeInteger(count) || count < 0 ||
+        (expectedCount !== undefined && count !== expectedCount)
+      ) throw new Error("incomplete_result");
+      expectedCount = count;
+      rows.push(...data);
+      if (data.length < PAGE_SIZE || rows.length >= expectedCount) {
+        if (rows.length !== expectedCount) throw new Error("incomplete_result");
+        return rows;
+      }
+    }
+  }
+
+  async function getByIds<Row>(
+    table: string,
+    columns: string,
+    idColumn: string,
+    ids: readonly string[],
+  ): Promise<Row[]> {
+    const uniqueIds = sortedModelIds(ids);
+    const rows: Row[] = [];
+    for (let offset = 0; offset < uniqueIds.length; offset += ID_CHUNK_SIZE) {
+      const { data, error, count } = await database()
+        .from(table)
+        .select(columns, { count: "exact" })
+        .in(idColumn, uniqueIds.slice(offset, offset + ID_CHUNK_SIZE))
+        .returns<Row[]>();
+      if (error || data === null) throw new Error("read_failed");
+      if (count === null || data.length !== count) {
+        throw new Error("incomplete_result");
+      }
+      rows.push(...data);
+    }
+    return rows;
+  }
+
+  return {
+    listAccounts: () =>
+      listAll<AccountRow>(
+        "accounts",
+        "id, model_id, platform, account_email",
+        "id",
+      ),
+    listModels: () =>
