+export const CONTRACT = "controlling-model-profiles.v1";
+export const MAX_ITEMS = 1000;
+export const MAX_BODY_BYTES = 1024 * 1024;
+
+export const PROFILE_KEYS = [
+  "name",
+  "age",
+  "city",
+  "occupation",
+  "hobbies",
+  "languages",
+  "personality",
+  "content_preferences",
+  "no_gos",
+  "place_of_birth",
+  "favorite_color",
+  "favorite_food",
+  "favorite_movie",
+  "favorite_music",
+  "dream",
+  "education",
+  "work",
+  "special_marks",
+  "natural_hair",
+  "shoe_size",
+  "bra_size",
+  "height",
+  "weight",
+  "content_anal_fingering",
+  "content_anal_penetration",
+  "content_anal_plug",
+  "content_audios_for_chat",
+  "content_dick_ratings",
+  "content_joi",
+  "content_moaning_name",
+  "content_orgasm",
+  "content_roleplay_costumes",
+  "content_squirting",
+  "content_video_speaking",
+] as const;
+
+export interface AccountRow {
+  id: string;
+  model_id: string | null;
+  platform: string;
+  account_email: string | null;
+}
+
+export interface ModelRow {
+  id: string;
+  name: string;
+  username: string | null;
+  model_active: boolean;
+}
+
+export interface ProfileSummaryRow {
+  model_id: string;
+  confirmed_at: string | null;
+  approved_snapshot: unknown;
+}
+
+export interface ProfileRow extends ProfileSummaryRow {
+  updated_at: string | null;
+}
+
+export type ProfileStatus = "approved" | "not_approved" | "none" | "unusable";
+export type ProjectedProfile = Partial<
+  Record<(typeof PROFILE_KEYS)[number], unknown>
+>;
+
+export interface Identity {
+  platform: string;
+  email: string;
+}
+
+export interface Resolution extends Identity {
+  same_platform_model_ids: string[];
+  other_platform_model_ids: string[];
+}
+
+export interface ResolvedProfile {
+  model_id: string;
+  model_exists: boolean;
+  profile_status: ProfileStatus;
+  confirmed_at: string | null;
+  updated_at: string | null;
+  profile: ProjectedProfile | null;
+}
+
+export type ValidRequest = { action: "list_models" } | {
+  action: "resolve";
+  identities: Identity[];
+  model_ids: string[];
+  include_profiles: boolean;
+};
+
+export type ValidationResult = { ok: true; value: ValidRequest } | {
+  ok: false;
+  error: "invalid_request" | "too_many_items";
+};
+
+export function normalizeLogin(value: unknown): string | null {
+  return typeof value === "string" ? value.trim().toLowerCase() || null : null;
+}
+
+export function platformKey(label: string): string {
+  return label.trim().toLowerCase().replace(/[^a-z0-9]/g, "");
+}
+
+export function isPlainObject(
+  value: unknown,
+): value is Record<string, unknown> {
+  if (value === null || typeof value !== "object") return false;
+  const prototype = Object.getPrototypeOf(value);
+  return prototype === Object.prototype || prototype === null;
+}
+
+export function projectProfile(snapshot: unknown): ProjectedProfile {
+  const projected: ProjectedProfile = {};
+  if (snapshot === null || typeof snapshot !== "object") return projected;
+  for (const key of PROFILE_KEYS) {
+    if (Object.prototype.hasOwnProperty.call(snapshot, key)) {
+      projected[key] = (snapshot as Record<string, unknown>)[key];
+    }
+  }
+  return projected;
+}
+
+export function profileStatus(
+  row:
+    | Pick<ProfileSummaryRow, "confirmed_at" | "approved_snapshot">
+    | undefined,
+): ProfileStatus {
+  if (row === undefined) return "none";
+  if (row.confirmed_at === null) return "not_approved";
+  return isPlainObject(row.approved_snapshot) &&
+      Object.keys(row.approved_snapshot).length > 0
+    ? "approved"
+    : "unusable";
+}
+
+const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+
+function isIdentity(value: unknown): value is Identity {
+  return isPlainObject(value) &&
+    typeof value.platform === "string" && value.platform.length >= 1 &&
+    value.platform.length <= 32 &&
+    typeof value.email === "string" && value.email.length >= 1 &&
+    value.email.length <= 320;
+}
+
+export function validateRequest(body: unknown): ValidationResult {
+  const invalid: ValidationResult = { ok: false, error: "invalid_request" };
+  if (!isPlainObject(body) || typeof body.action !== "string") return invalid;
+  if (body.action === "list_models") {
+    return { ok: true, value: { action: "list_models" } };
+  }
+  if (
+    !Array.isArray(body.identities) || !Array.isArray(body.model_ids) ||
+    (body.include_profiles !== undefined &&
+      typeof body.include_profiles !== "boolean") ||
+    !body.identities.every(isIdentity) ||
+    !body.model_ids.every((id) => typeof id === "string" && UUID.test(id))
+  ) return invalid;
+  if (body.identities.length > MAX_ITEMS || body.model_ids.length > MAX_ITEMS) {
+    return { ok: false, error: "too_many_items" };
+  }
+  if (body.action !== "resolve") return invalid;
+  return {
+    ok: true,
+    value: {
+      action: "resolve",
+      identities: body.identities.map(({ platform, email }) => ({
+        platform,
+        email,
+      })),
+      model_ids: body.model_ids.map((id: string) => id.toLowerCase()),
+      include_profiles: body.include_profiles === true,
+    },
+  };
+}
+
+export function sortedModelIds(ids: Iterable<string>): string[] {
+  return [...new Set(Array.from(ids, (id) => id.toLowerCase()))].sort();
+}
+
+export function buildResolutions(
+  identities: readonly Identity[],
+  accounts: readonly AccountRow[],
+): Resolution[] {
+  const byEmail = new Map<string, Map<string, Set<string>>>();
+  for (const account of accounts) {
+    const email = normalizeLogin(account.account_email);
+    if (!account.model_id || email === null) continue;
+    const platform = platformKey(account.platform);
+    let byPlatform = byEmail.get(email);
+    if (!byPlatform) byEmail.set(email, byPlatform = new Map());
+    let ids = byPlatform.get(platform);
+    if (!ids) byPlatform.set(platform, ids = new Set());
+    ids.add(account.model_id.toLowerCase());
+  }
+
+  return identities.map((identity) => {
+    const platform = platformKey(identity.platform);
+    const email = normalizeLogin(identity.email);
+    const same: string[] = [];
+    const other: string[] = [];
+    const matches = email === null ? undefined : byEmail.get(email);
+    for (const [accountPlatform, ids] of matches ?? []) {
+      const target = accountPlatform === platform ? same : other;
+      target.push(...ids);
+    }
+    return {
+      platform,
+      email: email ?? "",
+      same_platform_model_ids: sortedModelIds(same),
+      other_platform_model_ids: sortedModelIds(other),
+    };
+  });
+}
+
+export function buildProfiles(
+  ids: Iterable<string>,
+  modelsById: ReadonlyMap<string, ModelRow>,
+  profilesByModelId: ReadonlyMap<string, ProfileRow>,
+  includeProfiles: boolean,
+): ResolvedProfile[] {
+  return sortedModelIds(ids).map((modelId) => {
+    const modelExists = modelsById.has(modelId);
+    const row = profilesByModelId.get(modelId);
+    const status = modelExists ? profileStatus(row) : "none";
+    const approved = status === "approved" && row !== undefined;
+    return {
+      model_id: modelId,
+      model_exists: modelExists,
+      profile_status: status,
+      confirmed_at: approved && row.confirmed_at !== null
+        ? new Date(row.confirmed_at).toISOString()
+        : null,
+      updated_at: approved && row.updated_at !== null
+        ? new Date(row.updated_at).toISOString()
+        : null,
+      profile: approved && includeProfiles === true
+        ? projectProfile(row.approved_snapshot)
+        : null,
+    };
+  });
+}
