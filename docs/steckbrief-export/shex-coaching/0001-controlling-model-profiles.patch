+  for (const optional of [{}, { include_profiles: false }]) {
+    const f = fixture();
+    f.store.models = [model(A)];
+    f.store.profiles = [profile(A)];
+    const response = await f.invoke(
+      post({ action: "resolve", identities: [], model_ids: [A], ...optional }),
+    );
+    assertEquals(response.status, 200);
+    const body = await response.json();
+    assertEquals(body.profiles, [{
+      model_id: A,
+      model_exists: true,
+      profile_status: "approved",
+      confirmed_at: "2026-09-20T10:15:00.000Z",
+      updated_at: "2026-09-20T10:14:12.000Z",
+      profile: null,
+    }]);
+  }
+});
+
+Deno.test("resolve accepts empty lists and 1000 entries in both lists", async () => {
+  const f = fixture();
+  const empty = await f.invoke(
+    post({ action: "resolve", identities: [], model_ids: [] }),
+  );
+  assertEquals(empty.status, 200);
+  assertEquals(await empty.json(), {
+    contract: "controlling-model-profiles.v1",
+    resolutions: [],
+    profiles: [],
+  });
+  const max = await f.invoke(
+    post({
+      action: "resolve",
+      identities: Array(1000).fill({
+        platform: "4Based",
+        email: "lena@example.com",
+      }),
+      model_ids: Array(1000).fill(A),
+    }),
+  );
+  assertEquals(max.status, 200);
+  const body = await max.json();
+  assertEquals(body.resolutions.length, 1000);
+  assertEquals(body.profiles.length, 1);
+  assertEquals(body.profiles[0].model_exists, false);
+});
+
+Deno.test("each failing store operation returns the exact generic 500 body and one log without private data", async () => {
+  for (
+    const method of [
+      "listAccounts",
+      "listModels",
+      "listProfiles",
+      "getModelsByIds",
+      "getProfilesByModelIds",
+    ] as const
+  ) {
+    const f = fixture();
+    f.store.failOn = method;
+    const body = method === "listModels" || method === "listProfiles"
+      ? { action: "list_models" }
+      : {
+        action: "resolve",
+        identities: [{ platform: "4Based", email: "lena@example.com" }],
+        model_ids: [A],
+        include_profiles: true,
+      };
+    await expectError(await f.invoke(post(body)), 500, "internal_error");
+  }
+});
+
+Deno.test("unexpected configuration, stream and approved timestamp errors remain generic", async () => {
+  const badEnv = fixture({
+    env: () => {
+      throw new Error(PRIVATE_VALUES.join(" "));
+    },
+  });
+  await expectError(
+    await badEnv.invoke(post({ action: "list_models" })),
+    500,
+    "internal_error",
+  );
+  const badStream = fixture();
+  const stream = new ReadableStream({
+    start(controller) {
+      controller.error(new Error(PRIVATE_VALUES.join(" ")));
+    },
+  });
+  await expectError(
+    await badStream.invoke(postText(stream)),
+    500,
+    "internal_error",
+  );
+  const badDate = fixture();
+  badDate.store.models = [model(A)];
+  badDate.store.profiles = [
+    profile(A, { name: "Testmodell Fiktiva" }, "synthetic-invalid-date"),
+  ];
+  await expectError(
+    await badDate.invoke(
+      post({ action: "resolve", identities: [], model_ids: [A] }),
+    ),
+    500,
+    "internal_error",
+  );
+});
+
+Deno.test("unknown actions and invalid values never enter logs or error bodies", async () => {
+  const f = fixture();
+  await expectError(
+    await f.invoke(
+      post({
+        action: PRIVATE_VALUES.join("\n"),
+        identities: [],
+        model_ids: [],
+      }),
+    ),
+    400,
+    "invalid_request",
+  );
+  assertEquals(JSON.parse(f.logs[0]).action, null);
+  await expectError(
+    await f.invoke(
+      post({
+        action: "resolve",
+        identities: [{ platform: "4Based", email: "lena@example.com" }],
+        model_ids: [PRIVATE_VALUES.join(" ")],
+      }),
+    ),
+    400,
+    "invalid_request",
+  );
+});
+
+Deno.test("a throwing log sink is called once and yields a generic 500", async () => {
+  let calls = 0;
+  const handler = createHandler({
+    env: () => KEY,
+    store: new FakeStore(),
+    log: () => {
+      calls++;
+      throw new Error(PRIVATE_VALUES.join(" "));
+    },
+  });
+  await expectError(
+    await handler(post({ action: "list_models" })),
+    500,
+    "internal_error",
+  );
+  assertEquals(calls, 1);
+});
diff --git a/supabase/functions/controlling-model-profiles/handler.ts b/supabase/functions/controlling-model-profiles/handler.ts
new file mode 100644
index 00000000..54de8bf1
--- /dev/null
+++ b/supabase/functions/controlling-model-profiles/handler.ts
@@ -0,0 +1,196 @@
+import {
+  buildProfiles,
+  buildResolutions,
+  CONTRACT,
+  isPlainObject,
+  MAX_BODY_BYTES,
+  profileStatus,
+  sortedModelIds,
+  validateRequest,
+} from "./core.ts";
+import type { ShexStore } from "./store.ts";
+
+export interface HandlerDeps {
+  env: (name: string) => string | undefined;
+  store: ShexStore;
+  log: (line: string) => void;
+  now?: () => number;
+}
+
+function json(body: unknown, status = 200): Response {
+  return new Response(JSON.stringify(body), {
+    status,
+    headers: {
+      "content-type": "application/json; charset=utf-8",
+      "cache-control": "no-store",
+    },
+  });
+}
+
+async function equalKeys(expected: string, supplied: string): Promise<boolean> {
+  const encoder = new TextEncoder();
+  const [expectedDigest, suppliedDigest] = await Promise.all([
+    crypto.subtle.digest("SHA-256", encoder.encode(expected)),
+    crypto.subtle.digest("SHA-256", encoder.encode(supplied)),
+  ]);
+  const left = new Uint8Array(expectedDigest);
+  const right = new Uint8Array(suppliedDigest);
+  let difference = 0;
+  for (let i = 0; i < left.length; i++) difference |= left[i] ^ right[i];
+  return difference === 0;
+}
+
+// null signals a size violation; read bytes before decoding, including streams
+// with absent or understated Content-Length headers.
+async function readBody(req: Request): Promise<string | null> {
+  const contentLength = req.headers.get("content-length");
+  if (contentLength !== null && Number(contentLength) > MAX_BODY_BYTES) {
+    return null;
+  }
+  if (req.body === null) return "";
+  const reader = req.body.getReader();
+  const chunks: Uint8Array[] = [];
+  let size = 0;
+  try {
+    while (true) {
+      const { done, value } = await reader.read();
+      if (done) break;
+      size += value.byteLength;
+      if (size > MAX_BODY_BYTES) {
+        await reader.cancel().catch(() => {});
+        return null;
+      }
+      chunks.push(value);
+    }
+  } finally {
+    reader.releaseLock();
+  }
+  const bytes = new Uint8Array(size);
+  let offset = 0;
+  for (const chunk of chunks) {
+    bytes.set(chunk, offset);
+    offset += chunk.byteLength;
+  }
+  return new TextDecoder().decode(bytes);
+}
+
+export function createHandler(deps: HandlerDeps) {
+  const now = deps.now ?? Date.now;
+  return async (req: Request): Promise<Response> => {
+    let action: "list_models" | "resolve" | null = null;
+    let identities = 0;
+    let modelIds = 0;
+    let ms = 0;
+
+    async function dispatch(): Promise<Response> {
+      if (req.method !== "POST") {
+        return json({ error: "method_not_allowed" }, 405);
+      }
+      const expected = deps.env("CONTROLLING_MODEL_PROFILES_KEY")?.trim();
+      if (!expected) return json({ error: "not_configured" }, 503);
+      const supplied = req.headers.get("x-api-key")?.trim();
+      if (!supplied || !await equalKeys(expected, supplied)) {
+        return json({ error: "unauthorized" }, 401);
+      }
+      const text = await readBody(req);
+      if (text === null) return json({ error: "payload_too_large" }, 413);
+      let body: unknown;
+      try {
+        body = JSON.parse(text);
+      } catch {
+        return json({ error: "invalid_request" }, 400);
+      }
+      if (isPlainObject(body)) {
+        // Never copy arbitrary request strings into the log, including action.
+        if (body.action === "resolve" || body.action === "list_models") {
+          action = body.action;
+        }
+        identities = Array.isArray(body.identities)
+          ? body.identities.length
+          : 0;
+        modelIds = Array.isArray(body.model_ids) ? body.model_ids.length : 0;
+      }
+      const parsed = validateRequest(body);
+      if (!parsed.ok) return json({ error: parsed.error }, 400);
+      if (parsed.value.action === "list_models") {
+        const [models, profiles] = await Promise.all([
+          deps.store.listModels(),
+          deps.store.listProfiles(),
+        ]);
+        const profilesById = new Map(
+          profiles.map((profile) => [profile.model_id.toLowerCase(), profile]),
+        );
+        const result = models.map((model) => ({
+          model_id: model.id.toLowerCase(),
+          name: model.name,
+          username: model.username,
+          model_active: model.model_active,
+          profile_status: profileStatus(
+            profilesById.get(model.id.toLowerCase()),
+          ),
+        }));
+        result.sort((a, b) =>
+          a.name.localeCompare(b.name, "de") ||
+          a.model_id.localeCompare(b.model_id)
+        );
+        return json({ contract: CONTRACT, models: result });
+      }
+
+      const request = parsed.value;
+      const resolutions = buildResolutions(
+        request.identities,
+        await deps.store.listAccounts(),
+      );
+      const ids = sortedModelIds([
+        ...request.model_ids,
+        ...resolutions.flatMap((resolution) => [
+          ...resolution.same_platform_model_ids,
+          ...resolution.other_platform_model_ids,
+        ]),
+      ]);
+      const [models, profiles] = await Promise.all([
+        deps.store.getModelsByIds(ids),
+        deps.store.getProfilesByModelIds(ids),
+      ]);
+      return json({
+        contract: CONTRACT,
+        resolutions,
+        profiles: buildProfiles(
+          ids,
+          new Map(models.map((model) => [model.id.toLowerCase(), model])),
+          new Map(
+            profiles.map((
+              profile,
+            ) => [profile.model_id.toLowerCase(), profile]),
+          ),
+          request.include_profiles,
+        ),
+      });
+    }
+
+    let response: Response;
+    try {
+      const started = now();
+      try {
+        response = await dispatch();
+      } finally {
+        ms = Math.max(0, now() - started);
+      }
+    } catch {
+      response = json({ error: "internal_error" }, 500);
+    }
+    try {
+      deps.log(JSON.stringify({
+        fn: "controlling-model-profiles",
+        action,
+        status: response.status,
+        identities,
+        model_ids: modelIds,
+        ms,
+      }));
+    } catch {
+      return json({ error: "internal_error" }, 500);
+    }
+    return response;
+  };
+}
